# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Подключение Cloudflare: auto пробует QUIC и при необходимости HTTP/2
# CLOUDFLARED_PROTOCOL=auto
# CLOUDFLARED_EDGE_IP_VERSION=4
# CLOUDFLARED_METRICS_PORT=20241

# Необязательно: другие установленные в Ollama модели
# OLLAMA_MODEL=gemma4:12b-it-qat
# OLLAMA_VISION_MODEL=gemma4:12b-it-qat
# OLLAMA_EMBEDDING_MODEL=bge-m3
# WEB_SEARCH_BACKEND=auto
# RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Удержание моделей Ollama после запроса: 1800 секунд = 30 минут
# OLLAMA_KEEP_ALIVE_SECONDS=1800
# Число потоков CPU для reranker; без настройки используется выбор PyTorch
# RAG_CPU_THREADS=8
# Подготовка модели в фоне при запуске (1 — по умолчанию, 0 — при первом поиске)
# RAG_PRELOAD=1
# Срок актуальности результатов локального поиска: 300 секунд; 0 — без кэша
# RAG_CACHE_TTL_SECONDS=300
# Замеры времени в окне API: 1 — включены (по умолчанию), 0 — выключены
# PERFORMANCE_LOGGING=1

# Для отдельной тестовой копии базы (не требуется для обычного запуска)
# RAG_DB_PATH=/path/to/chroma_db_copy

# Ключ администратора FastAPI (для /knowledge, /upload, /monoliths)
ADMIN_KEY=

# Пользователи и сохранённые чаты: по умолчанию data/app.db (вне Git)
# TERRAMIND_DB_PATH=data/app.db
